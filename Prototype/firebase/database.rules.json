{
  "rules": {
    "room": {
      ".read": true,
      "presence": {
        "A": { ".write": true },
        "B": { ".write": true }
      },
      "session": { ".write": true },
      "strokes": { ".write": true },
      "live": {
        "A": { ".write": true },
        "B": { ".write": true }
      }
    },
    "trails": {
      ".read": true,
      "$station": {
        "notes": { ".write": true }
      }
    },
    "shares": {
      "$id": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['img', 't']) && newData.child('img').isString() && newData.child('img').val().length < 900000"
      }
    }
  }
}
